{
  "name": "tlvdemux",
  "version": "0.3.7",
  "description": "ARIB MMT/TLV demultiplexer for browsers, workers, and Node.js",
  "license": "MIT",
  "author": {
    "name": "huggy",
    "url": "https://huggy.moe",
    "email": "tlvdemux@huggy.moe"
  },
  "homepage": "https://github.com/makeding/tlvdemux#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/makeding/tlvdemux.git"
  },
  "bugs": {
    "url": "https://github.com/makeding/tlvdemux/issues"
  },
  "keywords": [
    "arib",
    "mmt",
    "tlv",
    "demuxer",
    "webassembly",
    "wasm",
    "hevc",
    "aac"
  ],
  "type": "commonjs",
  "main": "./dist/tlvdemux.js",
  "types": "./index.d.ts",
  "browser": "./dist/tlvdemux.js",
  "unpkg": "./dist/tlvdemux.js",
  "jsdelivr": "./dist/tlvdemux.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "require": "./dist/tlvdemux.js",
      "default": "./dist/tlvdemux.js"
    },
    "./mse-append-queue": {
      "types": "./mse-append-queue.d.ts",
      "import": "./mse-append-queue.mjs",
      "default": "./mse-append-queue.mjs"
    },
    "./mse-playback": {
      "types": "./mse-playback.d.ts",
      "import": "./mse-playback.mjs",
      "default": "./mse-playback.mjs"
    },
    "./mse-output-pipeline": {
      "types": "./mse-output-pipeline.d.ts",
      "import": "./mse-output-pipeline.mjs",
      "default": "./mse-output-pipeline.mjs"
    },
    "./mse-live-transition": {
      "types": "./mse-live-transition.d.ts",
      "import": "./mse-live-transition.mjs",
      "default": "./mse-live-transition.mjs"
    },
    "./track-selection": {
      "types": "./track-selection.d.ts",
      "import": "./track-selection.mjs",
      "default": "./track-selection.mjs"
    },
    "./stream-input": {
      "types": "./stream-input.d.ts",
      "import": "./stream-input.mjs",
      "default": "./stream-input.mjs"
    },
    "./recorded-source": {
      "types": "./recorded-source.d.ts",
      "import": "./recorded-source.mjs",
      "default": "./recorded-source.mjs"
    },
    "./mse-recorded-supply": {
      "types": "./mse-recorded-supply.d.ts",
      "import": "./mse-recorded-supply.mjs",
      "default": "./mse-recorded-supply.mjs"
    },
    "./worker-client": {
      "types": "./worker-tlvdemux.d.ts",
      "import": "./worker-tlvdemux.mjs",
      "default": "./worker-tlvdemux.mjs"
    },
    "./worker/demux-worker-runtime.js": "./worker/demux-worker-runtime.js",
    "./hlg-sdr-renderer": {
      "types": "./hlg-sdr-renderer.d.ts",
      "import": "./hlg-sdr-renderer.mjs",
      "default": "./hlg-sdr-renderer.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "docs/performance.md",
    "docs/browser-sdk-roadmap.md",
    "docs/browser-sdk-roadmap.ja.md",
    "index.d.ts",
    "hlg-sdr-renderer.d.ts",
    "hlg-sdr-renderer.mjs",
    "mse-append-queue.d.ts",
    "mse-append-queue.mjs",
    "mse-playback.d.ts",
    "mse-playback.mjs",
    "mse-playback-contract.mjs",
    "mse-playback-buffer.mjs",
    "mse-playback-flow-control.mjs",
    "mse-output-pipeline.d.ts",
    "mse-output-pipeline.mjs",
    "mse-live-transition.d.ts",
    "mse-live-transition.mjs",
    "track-selection.d.ts",
    "track-selection.mjs",
    "stream-input.d.ts",
    "stream-input.mjs",
    "recorded-source.d.ts",
    "recorded-source.mjs",
    "mse-recorded-supply.d.ts",
    "mse-recorded-supply.mjs",
    "worker-tlvdemux.d.ts",
    "worker-tlvdemux.mjs",
    "worker/",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build:wasm": "sh scripts/build-wasm.sh",
    "build:package": "cmake -E make_directory dist && cmake -E copy_if_different build-wasm/tlvdemux.js dist/tlvdemux.js",
    "build": "npm run build:wasm && npm run build:package",
    "benchmark:wasm": "node tests/wasm_benchmark.mjs",
    "test:subtitle-sample": "node tests/wasm_subtitle_metadata_sample.mjs dist/tlvdemux.js demo/test.tlv",
    "test:layer-sample": "node tests/wasm_layer_switch_sample.mjs dist/tlvdemux.js demo/audiotrack.tlv",
    "test:rain-startup-flow": "node tests/wasm_startup_flow_control_sample.mjs dist/tlvdemux.js demo/rain.tlv",
    "test:rain-seek": "node tests/wasm_seek_smoke.mjs dist/tlvdemux.js demo/rain.tlv 60 200 380",
    "test:single-track-resilience": "node tests/wasm_single_track_damage_flow_sample.mjs dist/tlvdemux.js demo/20260828-141-020000_99332dc9-025e-4e76-afc4-e31c3d577059.mmts",
    "test:manual-auto-layer": "node tests/wasm_manual_auto_layer_sample.mjs dist/tlvdemux.js demo/audiotrack.tlv restore && node tests/wasm_manual_auto_layer_sample.mjs dist/tlvdemux.js demo/rain.tlv defer",
    "test:inventory-samples": "node tests/inventory_sample_regression.mjs",
    "test:inventory-samples:hardware": "node tests/inventory_sample_regression.mjs --hardware-only",
    "test": "node tests/live_stream_coalescing.mjs && node tests/recorded_source.mjs && node tests/mse_recorded_supply.mjs && node tests/mse_append_queue.mjs && node tests/mse_output_pipeline.mjs && node tests/mse_gap_recovery.mjs && node tests/mse_playback_resilience.mjs && node tests/mse_playback_flow_control.mjs && node tests/mse_recorded_seek.mjs && node tests/mse_live_transition.mjs && node tests/mse_playback_intent.mjs && node tests/demo_audio_only_contract.mjs && node tests/worker_result_value.mjs && node tests/worker_track_selection.mjs && node tests/asset_group_selection.mjs && node tests/subtitle_track_selection.mjs && node tests/hlg_sdr_lut.mjs dist/tlvdemux.js && node tests/hlg_sdr_renderer.mjs && node tests/wasm_smoke.mjs dist/tlvdemux.js && node tests/wasm_transport_metadata.mjs dist/tlvdemux.js",
    "prepack": "npm run build && npm test"
  }
}
